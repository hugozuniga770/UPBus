# Copia este archivo como .env solo si necesitas cambiar algo.
# Sin variables, UPBus arranca listo para desarrollar en tu computadora.
# .env no se sube al repositorio.

# Clave secreta de Django. En un servidor público, una larga y al azar.
UPBUS_SECRET_KEY=solo-para-desarrollo-cambiar-en-el-servidor

# 1 para desarrollar (muestra errores); 0 en un servidor público.
UPBUS_DEBUG=1

# Direcciones desde las que se puede abrir la app, separadas por comas.
UPBUS_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# Orígenes en los que se confía para el token CSRF (la interfaz y el túnel).
UPBUS_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.trycloudflare.com

# Otro archivo de padrón (por defecto: padron/padron.local.json si existe; si no, padron/padron.json).
# UPBUS_PADRON=padron/otro.json

# Otro archivo de base de datos (por defecto: db.sqlite3 en la carpeta del proyecto).
# UPBUS_BD=db.sqlite3

# Metros a los que el bus «llega» a una parada (por defecto, 50). Se calibra con los viajes de prueba.
# UPBUS_RADIO_DE_LLEGADA_M=50
